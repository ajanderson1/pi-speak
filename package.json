{
  "name": "@ajanderson1/pi-speak",
  "version": "0.1.0",
  "description": "Opt-in spoken summaries for completed Pi responses.",
  "keywords": [
    "pi",
    "pi-extension",
    "tts",
    "speech",
    "summary"
  ],
  "license": "MIT",
  "author": "AJ Anderson",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
